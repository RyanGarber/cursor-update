{
	"name": "@ryangarber/sod-off",
	"version": "1.0.0",
	"description": "Update Cursor, IDEA, Claude Code, Codex, and more - without leaving sod behind.",
	"type": "module",
	"bin": {
		"sod-off": "./src/index.ts"
	},
	"scripts": {
		"start": "bun run ./src/index.ts",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"build": "bun ./scripts/build.ts",
		"install": "bun build ./src/index.ts --compile --outfile ~/.local/bin/sod-off"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
