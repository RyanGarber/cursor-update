{
	"name": "@ryangarber/sod-off",
	"version": "1.0.0",
	"description": "Update Cursor, IDEA, Claude Code, Codex, and more - without leaving sod behind.",
	"type": "module",
	"bin": {
		"sod-off": "./src/main.ts"
	},
	"scripts": {
		"start": "node ./src/main.ts",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "node ./scripts/build.ts",
		"install": "bun build ./src/main.ts --compile --outfile ~/.local/bin/sod-off"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
