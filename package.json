{
	"name": "@ryangarber/sod-off",
	"version": "1.0.0",
	"description": "Update Cursor, IDEA, Claude Code, Codex, and more - without leaving sod behind.",
	"type": "module",
	"bin": {
		"sod-off": "./src/main.ts"
	},
	"scripts": {
		"start": "node ./src/main.ts",
		"check": "biome check .",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "node ./scripts/build.ts",
		"install:local": "bun build ./src/main.ts --compile --outfile ~/.local/bin/sod-off"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"devEngines": {
		"runtime": [
			{
				"name": "node",
				"version": "^24.0.0",
				"onFail": "download"
			},
			{
				"name": "bun",
				"version": "^1.4.0",
				"onFail": "download"
			}
		]
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"@optique/core": "^1.3.6",
		"@optique/man": "^1.3.6",
		"@optique/run": "^1.3.6",
		"listr2": "^11.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/sod-off.git"
	}
}
